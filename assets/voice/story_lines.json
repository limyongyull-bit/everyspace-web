 },
 {
  "id": "n_dont",
  "voice": "niki",
  "text": "Don't go where the lights go out. They're not going out. That thing eats the light.",
  "ko": "\ubd88 \uaebc\uc9c0\ub294 \ucabd\uc73c\ub85c \uac00\uc9c0 \ub9c8. \ubd88\uc774 \uaebc\uc9c0\ub294 \uac8c \uc544\ub2c8\ub77c, \uc800\uac8c \ube5b\uc744 \uba39\ub294 \uac70\uc57c.",
  "dur": 5.08
 },
 {
